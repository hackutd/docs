{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "HackUTD Docs",
  "colors": {
    "primary": "#FF005E",
    "light": "#FF005E",
    "dark": "#FF005E"
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Projects",
        "pages": [
          "jury",
          {
            "group": "Harp",
            "pages": [
              "harp/overview",
              "harp/why-harp",
              {
                "group": "Features",
                "pages": [
                  "harp/features/hackers",
                  "harp/features/applications",
                  "harp/features/event-day",
                  "harp/features/public-content",
                  "harp/features/administration"
                ]
              },
              "harp/architecture",
              {
                "group": "Adopting Harp",
                "pages": [
                  "harp/adoption/guide",
                  "harp/adoption/forking",
                  "harp/adoption/marketing-site"
                ]
              },
              {
                "group": "Deployment",
                "pages": [
                  "harp/deployment/local",
                  "harp/deployment/production",
                  "harp/deployment/environment"
                ]
              },
              {
                "group": "Reference",
                "pages": [
                  "harp/reference/public-api",
                  "harp/reference/migrations"
                ]
              },
              "harp/contributing"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/hackutd"
      }
    ],
    "primary": {
      "type": "button",
      "label": "HackUTD",
      "href": "https://hackutd.co"
    }
  },
  "redirects": [
    {
      "source": "/harp/quickstart",
      "destination": "/harp/deployment/local"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/hackutd",
      "github": "https://github.com/hackutd",
      "instagram": "https://instagram.com/hackutd"
    }
  }
}
